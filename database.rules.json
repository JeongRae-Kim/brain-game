{
  "rules": {
    "adminCode": { ".read": false, ".write": false },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.child('code').val() == root.child('adminCode').val()"
      }
    },
    "custom": {
      ".read": "auth != null",
      "$cat": {
        ".write": "auth != null && root.child('admins').child(auth.uid).child('code').val() == root.child('adminCode').val()",
        ".validate": "!newData.exists() || (newData.isString() && newData.val().length < 40000)"
      }
    },
    "rooms": {
      "$room": {
        ".read": "auth != null",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid",
            "name": { ".validate": "newData.isString() && newData.val().length <= 10" }
          }
        },
        "host": {
          ".write": "auth != null && (!data.exists() || data.val() == auth.uid || root.child('rooms').child($room).child('players').child(data.val()).child('online').val() != true)",
          ".validate": "!newData.exists() || newData.val() == auth.uid || data.val() == auth.uid"
        },
        "round": {
          ".write": "auth != null && root.child('rooms').child($room).child('host').val() == auth.uid"
        },
        "settings": {
          ".write": "auth != null && (root.child('rooms').child($room).child('host').val() == auth.uid || root.child('admins').child(auth.uid).child('code').val() == root.child('adminCode').val())"
        },
        "used": {
          ".write": "auth != null && (root.child('rooms').child($room).child('host').val() == auth.uid || root.child('admins').child(auth.uid).child('code').val() == root.child('adminCode').val())"
        },
        "mighty": {
          "seats": {
            "$i": {
              ".write": "auth != null && ((!data.exists() && newData.val() == auth.uid) || (data.val() == auth.uid && !newData.exists()) || root.child('rooms').child($room).child('host').val() == auth.uid)"
            }
          },
          "setup": { ".write": "auth != null && root.child('rooms').child($room).child('host').val() == auth.uid" },
          "game": { ".write": "auth != null && root.child('rooms').child($room).child('host').val() == auth.uid" },
          "actions": {
            ".write": "auth != null && root.child('rooms').child($room).child('host').val() == auth.uid",
            "$id": {
              ".write": "auth != null && ((!data.exists() && newData.child('uid').val() == auth.uid) || (!newData.exists() && root.child('rooms').child($room).child('host').val() == auth.uid))"
            }
          }
        },
        "chat": {
          "$msg": {
            ".write": "auth != null && ((!data.exists() && newData.child('uid').val() == auth.uid) || !newData.exists())",
            ".validate": "!newData.exists() || (newData.child('text').isString() && newData.child('text').val().length <= 100 && newData.child('name').isString() && newData.child('name').val().length <= 10)"
          }
        },
        "best": {
          "$key": {
            "$scope": {
              "$uid": {
                ".write": "auth != null && auth.uid == $uid",
                ".validate": "newData.child('timeMs').isNumber() && newData.child('name').isString() && newData.child('name').val().length <= 10"
              }
            }
          }
        },
        "history": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid"
          }
        },
        "results": {
          "$roundId": {
            "$uid": {
              ".write": "auth != null && auth.uid == $uid",
              "name": { ".validate": "newData.isString() && newData.val().length <= 10" },
              "timeMs": { ".validate": "newData.isNumber() && newData.val() > 0" }
            }
          }
        }
      }
    }
  }
}
